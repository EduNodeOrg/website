/* CSP updated 2024-05-29
  # Strict Transport Security — enforce HTTPS for 1 year, include subdomains
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Clickjacking protection — only allow framing from same origin
  X-Frame-Options: SAMEORIGIN

  # MIME-type sniffing protection
  X-Content-Type-Options: nosniff

  # XSS filter (legacy browsers)
  X-XSS-Protection: 1; mode=block

  # Referrer policy — send origin only on same-origin requests
  Referrer-Policy: strict-origin-when-cross-origin

  # Permissions policy — restrict access to sensitive browser APIs
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://www.paypal.com"), usb=(), accelerometer=(), gyroscope=()

  # Content Security Policy — restrict script/style/font/image sources
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://apis.google.com https://accounts.google.com https://www.googletagmanager.com https://www.google-analytics.com https://pagead2.googlesyndication.com https://www.paypal.com https://use.fontawesome.com https://www.youtube.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://use.fontawesome.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com https://use.fontawesome.com; img-src 'self' data: https:; connect-src 'self' https://api.edunode.org https://edunode.herokuapp.com https://www.paypal.com https://www.sandbox.paypal.com https://www.google-analytics.com https://region1.google-analytics.com https://cdnjs.cloudflare.com https://www.googleapis.com wss:; frame-src https://www.paypal.com https://accounts.google.com https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'

  # CORS — restrict to edunode.org and its app subdomain only
  Access-Control-Allow-Origin: https://edunode.org

# ─── Caching ──────────────────────────────────────────────────────────
# CRA emits content-hashed files under /static — safe to cache forever
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Static images/illustrations — not hashed, cache for a week
/assets/*
  Cache-Control: public, max-age=604800

# HTML must always revalidate so new deploys take effect immediately
/index.html
  Cache-Control: public, max-age=0, must-revalidate
